# --- Core API settings ---
RCORE_HTTP_PORT=8080
RCORE_LOG_LEVEL=info

# --- Provider endpoints / keys ---
RCORE_BINANCE_BASE_URL=https://api.binance.com
RCORE_FOREX_BASE_URL=https://api.exchangerate.host
RCORE_IRR_BASE_URL=https://api.exchangerate.host
RCORE_IRR_API_KEY=your-irr-api-key
RCORE_METALS_BASE_URL=https://api.metals.example.com

# --- Bot settings (also used by API clients) ---
BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_ID=123456789
BOT_LOG_LEVEL=INFO
RCORE_API_BASE_URL=http://localhost:8080
# Optional: proxy for Telegram if direct access is blocked (http/https/socks supported by aiohttp).
# Leave unset when running in Docker unless the proxy is reachable from inside the container.
# TELEGRAM_PROXY_URL=http://127.0.0.1:1080

# --- Database / storage (bot SQLite defaults to local file) ---
# For SQLite (default): no env needed; see ratecore_bot.db in repo root.
# Example for overriding:
# BOT_DATABASE_URL=sqlite+aiosqlite:///./ratecore_bot.db
